# Copy to terraform.tfvars (gitignored) and replace placeholder bucket name.
aws_region                  = "us-east-1"
project_name                = "aws-plat"
environment                 = "staging"
vpc_cidr                    = "10.20.0.0/16"
azs                         = ["us-east-1a", "us-east-1b"]
public_subnets              = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnets             = ["10.20.11.0/24", "10.20.12.0/24"]
isolated_subnets            = ["10.20.21.0/24", "10.20.22.0/24"]
enable_nat_gateway          = true
single_nat_gateway          = false
artifacts_bucket_name       = "replace-with-unique-staging-artifacts-bucket"
s3_force_destroy            = false
alb_deletion_protection     = false
acm_certificate_arn         = null
instance_type               = "t3.small"
asg_min_size                = 2
asg_max_size                = 4
asg_desired_capacity        = 2
root_volume_size_gb         = 20
log_retention_days          = 30
kms_deletion_window_in_days = 14
tags = {
  Owner      = "platform-engineering"
  CostCenter = "cloud-infra"
}
