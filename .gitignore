# Local .terraform directories
**/.terraform/*
**/.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*
*.tfplan

# Crash log files
crash.log
crash.*.log

# Variable and backend config files (keep *.example tracked)
*.tfvars
!*.tfvars.example
*.tfvars.json
!*.tfvars.json.example
backend.hcl
!backend.hcl.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration & secrets
.terraformrc
terraform.rc
.env
.env.*
!.env.example
*.pem
*.key

# Local backups & reports
backups/
*.sarif
